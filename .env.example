# Copy this file to .env.local for local development, or add the same
# names in Vercel: Project, Settings, Environment Variables.
# Never commit real values.

# From the GitHub App's settings page (General).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# A long random string that encrypts the sign-in cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# The 2 repos, as owner/name.
TOKENS_DATA_REPO=jjjjn-code/ual-tokens-data
TOKENS_CODE_REPO=jjjjn-code/ual-tokens-sandbox

# Branches. Both default to main.
# TOKENS_DATA_BRANCH=main
# TOKENS_CODE_BRANCH=main

# Demo mode: a fake GitHub inside the tool, for trying push without set-up.
# Ignored when the GitHub settings above are filled in.
# TOKENS_DEMO=1
